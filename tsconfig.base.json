{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "mono-magic"
    ],
    "paths": {
      "@mono-magic/interfaces": [
        "./libs/ui/interfaces/src/index.ts"
      ],
      "@mono-magic/ng-mat": [
        "./libs/ui/ng-mat/src/index.ts"
      ]
    }
  }
}
