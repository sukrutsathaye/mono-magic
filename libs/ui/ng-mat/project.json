{
  "name": "ng-mat",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/ng-mat/src",
  "prefix": "magic",
  "projectType": "library",
  "tags": ["scope:ui", "framework:angular", "ds:material"],
  "targets": {
    "storybook": {
      "executor": "@storybook/angular-vite:start-storybook",
      "continuous": true,
      "readyWhen": {
        "port": "{env.SBCONFIG_PORT ?? options.port ?? 9009}",
        "host": "{env.SBCONFIG_HOSTNAME ?? options.host ?? localhost}"
      },
      "options": {
        "port": 4400,
        "configDir": "libs/ui/ng-mat/.storybook",
        "tsConfig": "libs/ui/ng-mat/.storybook/tsconfig.json",
        "styles": [
          "libs/ui/ng-mat/src/theme/styles.scss"
        ]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular-vite:build-storybook",
      "outputs": [
        "{options.outputDir}"
      ],
      "options": {
        "outputDir": "dist/storybook/ng-mat",
        "configDir": "libs/ui/ng-mat/.storybook",
        "tsConfig": "libs/ui/ng-mat/.storybook/tsconfig.json",
        "styles": [
          "libs/ui/ng-mat/src/theme/styles.scss"
        ]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": [
        "build-storybook"
      ],
      "readyWhen": {
        "signal": true
      },
      "options": {
        "buildTarget": "ng-mat:build-storybook",
        "staticFilePath": "dist/storybook/ng-mat",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "ng-mat:build-storybook:ci"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/ui/ng-mat",
        "command": "vitest run --project=ng-mat"
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/ui/ng-mat",
        "command": "vitest run --project=ng-mat-storybook"
      }
    }
  }
}
