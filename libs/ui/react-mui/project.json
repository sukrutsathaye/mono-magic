{
  "name": "react-mui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "libs/ui/react-mui",
  "sourceRoot": "libs/ui/react-mui/src",
  "projectType": "library",
  "tags": ["scope:ui", "framework:react", "ds:material"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/ui/react-mui",
        "command": "vitest run --project=react-mui"
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/ui/react-mui",
        "command": "vitest run --project=react-mui-storybook"
      }
    },
    "update-snapshots": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/ui/react-mui",
        "command": "vitest run --project=react-mui-storybook -u"
      }
    },
    "test-storybook-coverage": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/ui/react-mui",
        "command": "vitest run --project=react-mui-storybook --coverage.enabled=true --coverage.reportsDirectory=./test-output/storybook/coverage --coverage.thresholds.lines=0 --coverage.thresholds.statements=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0"
      }
    }
  }
}
