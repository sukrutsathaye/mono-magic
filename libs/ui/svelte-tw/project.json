{
  "name": "svelte-tw",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "libs/ui/svelte-tw",
  "sourceRoot": "libs/ui/svelte-tw/src",
  "projectType": "library",
  "tags": ["scope:ui", "framework:svelte", "ds:tailwind", "lang:ts"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/ui/svelte-tw",
        "command": "vitest run --project=svelte-tw"
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/ui/svelte-tw",
        "command": "vitest run --project=svelte-tw-storybook"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "libs/ui/svelte-tw",
        "command": "svelte-check --tsconfig ./tsconfig.lib.json"
      }
    }
  }
}
