{
  "name": "rs-utils-design-tokens",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/utils/rs-design-tokens/src",
  "tags": ["scope:utils", "type:util", "lang:rust"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/target/rs-design-tokens/lint"],
      "options": {
        "command": "cargo clippy --all-targets --target-dir ../../../dist/target/rs-design-tokens/lint -- -D warnings",
        "cwd": "libs/utils/rs-design-tokens"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/target/rs-design-tokens/test"],
      "options": {
        "command": "cargo test --target-dir ../../../dist/target/rs-design-tokens/test",
        "cwd": "libs/utils/rs-design-tokens"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/target/rs-design-tokens/build"],
      "options": {
        "command": "cargo build --release --target-dir ../../../dist/target/rs-design-tokens/build",
        "cwd": "libs/utils/rs-design-tokens"
      }
    }
  }
}
