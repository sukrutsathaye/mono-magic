      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/target/rs-pose-math/build"],
      "options": {
        "command": "cargo build --release --target-dir ../../../dist/target/rs-pose-math/build",
